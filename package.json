{
    "name": "jazzsvelte",
    "private": false,
    "version": "0.1.0",
    "scripts": {
        "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
        "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
        "lint": "prettier --check . && eslint .",
        "format": "prettier --write \"{components,pages,service,api-scripts}/**/*.{js,ts,svelte,d.ts}\"",
        "format:check": "prettier --check \"{components,pages,service,api-scripts}/**/*.{js,ts,svelte,d.ts}\"",
        "lint:fix": "lint --fix --ignore-path .gitignore .",
        "importCmp": "pnpx tsx ./scripts/importCmp",
        "importCmpDocList": "pnpx tsx ./scripts/importCmpDocList",
        "generateCmp": "pnpx tsx ./scripts/generateCmp",
        "tailwindDocPage": "pnpx tsx ./scripts/tailwindDocPage"
    },
    "devDependencies": {
        "@fontsource/fira-mono": "^5.2.7",
        "@rollup/plugin-alias": "^5.1.1",
        "@rollup/plugin-babel": "^6.1.0",
        "@rollup/plugin-commonjs": "^28.0.8",
        "@rollup/plugin-node-resolve": "^16.0.3",
        "@rollup/plugin-replace": "^6.0.2",
        "@stackblitz/sdk": "1.11.0",
        "@sveltejs/adapter-auto": "^7.0.0",
        "@sveltejs/kit": "^2.47.3",
        "@sveltejs/vite-plugin-svelte": "^6.2.1",
        "@testing-library/jest-dom": "^6.9.1",
        "@testing-library/svelte": "^5.2.8",
        "@testing-library/user-event": "^14.6.1",
        "@tsconfig/svelte": "^5.0.5",
        "@types/eslint": "9.6.1",
        "@types/jest": "^30.0.0",
        "@types/node": "^24.9.1",
        "@types/prismjs": "^1.26.5",
        "@typescript-eslint/eslint-plugin": "^8.46.2",
        "@typescript-eslint/parser": "^8.46.2",
        "autoprefixer": "^10.4.21",
        "eslint": "^9.38.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-svelte": "^3.12.5",
        "gulp": "^5.0.1",
        "gulp-concat": "^2.6.1",
        "gulp-flatten": "^0.4.0",
        "gulp-rename": "^2.1.0",
        "gulp-uglify": "^3.0.2",
        "gulp-uglifycss": "^1.1.0",
        "jsdom": "^27.0.1",
        "postcss": "^8.5.6",
        "prettier": "^3.6.2",
        "prettier-plugin-svelte": "^3.4.0",
        "rollup": "^4.52.5",
        "rollup-plugin-postcss": "^4.0.2",
        "rollup-plugin-terser": "^7.0.2",
        "sass": "^1.93.2",
        "svelte": "^5.41.2",
        "svelte-check": "^4.3.3",
        "tslib": "^2.8.1",
        "tsx": "^4.20.6",
        "typedoc": "0.28.14",
        "typescript": "5.9.3",
        "vite": "^7.1.11",
        "vitest": "^4.0.1"
    },
    "engines": {
        "node": ">=18.13"
    },
    "type": "module",
    "dependencies": {
        "picomatch": "^4.0.3"
    }
}
